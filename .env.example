# Postgres. A Neon connection string works as-is; any Postgres does.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Where this instance is reachable. Verification links, reset links and the
# agent setup snippet are built from it, so getting it wrong sends people --
# and their agents -- to the wrong host.
TODOX_PUBLIC_URL=http://localhost:3000

# Email over SMTP. Leave these unset and messages are printed to the server log
# instead of being sent -- fine for development, and nothing disappears
# silently. Mail only goes out when all four are set.
#
# Port 587 upgrades with STARTTLS and is the default; 465 is TLS from the
# start. The address in MAIL_FROM should match SMTP_USER -- most providers
# reject a From they did not authenticate.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=you@yourdomain
# SMTP_PASS=
# MAIL_FROM=todox <you@yourdomain>
