# Postgres. A Neon connection string works as-is; any Postgres does.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Where this instance is reachable. Verification and password-reset links are
# built from it, so getting it wrong sends people to the wrong host.
TODOX_PUBLIC_URL=http://localhost:3000

# Email. Leave both unset and messages are printed to the server log instead
# of being sent -- fine for development, and nothing disappears silently.
# RESEND_API_KEY=re_...
# MAIL_FROM=todox <noreply@yourdomain>
