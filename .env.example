# Postgres, over a normal connection. Any Postgres 15+ does: a container beside
# the app, a managed one, or the one Docker starts for the tests. `sslmode` is
# only needed when the database is somewhere the connection leaves the machine.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# How many connections this process may hold. The default of 10 suits an app
# that answers a request with several short statements; raise it only after
# checking Postgres' own max_connections, which every replica shares.
# DATABASE_POOL_MAX=10

# How many proxies sit between the internet and this process, counted so the
# rate limiter can tell callers apart. `x-forwarded-for` grows left to right and
# only its right-hand end is written by machines we run, so the client's address
# is that many steps back from the end; reading the left-hand end reads whatever
# the caller put there, which is one forged header away from an unlimited number
# of login attempts.
#
# Behind one reverse proxy this is 1, which is the default. Behind a CDN as well
# it is 2, because the CDN appends the client and the proxy then appends the
# CDN. Set it to 0 if nothing forwards to this process: exposed directly, every
# forwarding header arrived from the caller and none of them can be believed.
#
# Count the hops on the deployment rather than guessing. Too low only makes the
# buckets coarse; too high reaches back into the part of the header the caller
# controls, which is the whole problem this exists to avoid.
# TRUSTED_PROXY_HOPS=1

# Where this instance is reachable. Verification links, reset links and the
# agent setup snippet are built from it, so getting it wrong sends people --
# and their agents -- to the wrong host.
TODOX_PUBLIC_URL=http://localhost:3000

# Email over SMTP. Leave these unset and messages are printed to the server log
# instead of being sent -- fine for development, and nothing disappears
# silently. Mail only goes out when all four are set.
#
# Port 587 upgrades with STARTTLS and is the default; 465 is TLS from the
# start.
#
# What MAIL_FROM has to be depends on the provider, and getting it wrong is a
# rejected message rather than a silent one. With a mailbox provider it is
# usually the address that authenticated, because most reject a From they did
# not. With an API-key provider it is any address on a domain you verified with
# them -- Resend, for instance, authenticates as the literal user `resend` and
# would reject `resend@...` as a sender.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=you@yourdomain
# SMTP_PASS=
# MAIL_FROM=todox <you@yourdomain>
#
# Resend, which is what todox.dev uses:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# MAIL_FROM=todox <noreply@mail.yourdomain>
