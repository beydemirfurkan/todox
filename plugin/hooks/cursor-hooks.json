{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "TODOX_PLUGIN_TOKEN=\"${token}\" sh \"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" session-start cursor",
        "timeout": 8
      }
    ],
    "postToolUse": [
      {
        "command": "TODOX_PLUGIN_TOKEN=\"${token}\" sh \"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" post-tool-use cursor",
        "timeout": 3
      }
    ],
    "afterFileEdit": [
      {
        "command": "TODOX_PLUGIN_TOKEN=\"${token}\" sh \"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" post-tool-use cursor",
        "timeout": 3
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "TODOX_PLUGIN_TOKEN=\"${token}\" sh \"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" user-prompt-submit cursor",
        "timeout": 3
      }
    ],
    "stop": [
      {
        "command": "TODOX_PLUGIN_TOKEN=\"${token}\" sh \"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" stop cursor",
        "timeout": 10,
        "loop_limit": 1
      }
    ],
    "sessionEnd": [
      {
        "command": "TODOX_PLUGIN_TOKEN=\"${token}\" sh \"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" session-end cursor",
        "timeout": 5
      }
    ]
  }
}
